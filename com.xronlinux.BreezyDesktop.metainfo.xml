<component type="desktop-application">
  <id>com.xronlinux.BreezyDesktop</id>
  <name>Breezy Desktop</name>
  <summary>XR virtual desktop for GNOME</summary>
  <developer id="com.xronlinux">
    <name>Wayne Heaney</name>
  </developer>
  <!-- appstream-builder drops <developer> from the repository catalog -->
  <developer_name>Wayne Heaney</developer_name>
  <launchable type="desktop-id">com.xronlinux.BreezyDesktop.desktop</launchable>
  <description>
    <p>Breezy Desktop turns supported XR glasses from VITURE, XREAL, Rokid and TCL/RayNeo into a virtual desktop, with multiple displays anchored in space around you.</p>
    <p>This package contains the GNOME Shell extension and its control panel. Log out and log back in after the installation to load the extension.</p>
    <p>The virtual desktop features come with a free trial, after which a Productivity license from the author is required.</p>
  </description>
